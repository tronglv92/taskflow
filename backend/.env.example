# TaskFlow Backend Configuration
# Copy this file to .env and update values for your environment.
# Every setting has a safe default: with no .env at all the app starts and
# falls back to a local SQLite database (sqlite:///./taskflow.db).

# Application settings
APP_NAME=TaskFlow
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database. Postgres example shown; if this is unset the app uses SQLite.
DATABASE_URL=postgresql://taskflow:taskflow@db:5432/taskflow

# Security / JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: JSON array of origins allowed to call the API from a browser
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Server
HOST=0.0.0.0
PORT=8000
